#!/usr/bin/env bash
# Dump production Postgres for Duply (or cron). Custom format (-Fc).
#
# Usage:
#   bin/docker-prod-backup-db
#   BACKUP_DIR=/var/backups/voctoweb bin/docker-prod-backup-db
#
# Duply: run this in the profile PRE command, and include BACKUP_DIR in the
# backup source (see docker/production/duply-pre.example).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "${ROOT}"
COMPOSE=("${ROOT}/bin/docker-prod")

BACKUP_DIR="${BACKUP_DIR:-/var/backups/voctoweb}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
LATEST="${BACKUP_DIR}/voctoweb-latest.dump"
DATED="${BACKUP_DIR}/voctoweb-${STAMP}.dump"
KEEP_DAYS="${BACKUP_KEEP_DAYS:-14}"

DB_USER="$("${COMPOSE[@]}" exec -T postgres printenv POSTGRES_USER | tr -d '\r')"
DB_NAME="$("${COMPOSE[@]}" exec -T postgres printenv POSTGRES_DB | tr -d '\r')"
DB_USER="${DB_USER:-voctoweb}"
DB_NAME="${DB_NAME:-voctoweb}"

mkdir -p "${BACKUP_DIR}"

echo "==> pg_dump ${DB_NAME} → ${LATEST}"
"${COMPOSE[@]}" exec -T postgres \
  pg_dump -U "${DB_USER}" -d "${DB_NAME}" -Fc --no-owner --no-acl \
  > "${LATEST}.tmp"
mv -f "${LATEST}.tmp" "${LATEST}"
cp -f "${LATEST}" "${DATED}"

# Drop dated dumps older than KEEP_DAYS (latest is always kept)
find "${BACKUP_DIR}" -maxdepth 1 -type f -name 'voctoweb-2*.dump' -mtime "+${KEEP_DAYS}" -delete 2>/dev/null || true

ls -lh "${LATEST}" "${DATED}"
echo "Backup OK."

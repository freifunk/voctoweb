# Build context hygiene for Dockerfile / Dockerfile.production
.git
.gitignore
.dockerignore

# Local / large / secret
migration
*.dump
docker/db
docker/content
docker/ssh
docker/production/.env
docker/production/database.yml
docker/production/settings.yml

# Dev / test noise
log
tmp
storage
coverage
vendor/bundle
node_modules
.ruby-lsp
.idea
.vscode

# Docs drawings (not needed at runtime)
docs/*.png
docs/*.drawio

# Production image for media.freifunk.net (Compose). Dev still uses ./Dockerfile.
ARG RUBY_VERSION=3.4
FROM ruby:${RUBY_VERSION}-alpine AS build

RUN apk add --no-cache \
  build-base \
  curl \
  g++ \
  gcc \
  git \
  libffi-dev \
  libxml2-dev \
  libxslt-dev \
  make \
  musl-dev \
  nodejs \
  patch \
  postgresql-dev \
  tzdata \
  yaml-dev

WORKDIR /voctoweb

ENV BUNDLE_FORCE_RUBY_PLATFORM=1 \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT=1 \
    RAILS_ENV=production \
    MAKEFLAGS="-j$(nproc)"

COPY Gemfile Gemfile.lock ./
RUN gem install -v 2.5.20 bundler \
  && bundle install --jobs="$(nproc)" \
  && rm -rf ~/.bundle/cache

COPY . .

# Stub configs so assets:precompile can boot without secrets mounted.
COPY docker/production/database.yml.example config/database.yml
COPY docker/production/settings.yml.example config/settings.yml

ARG SECRET_KEY_BASE=assets-precompile-dummy
ENV SECRET_KEY_BASE=${SECRET_KEY_BASE} \
    DEVISE_SECRET_KEY=${SECRET_KEY_BASE} \
    POSTGRES_PASSWORD=dummy \
    SKIP_ELASTICSEARCH=1

RUN bundle exec rails assets:precompile \
  && rm -rf tmp/cache node_modules

# --- runtime ---
FROM ruby:${RUBY_VERSION}-alpine

RUN apk add --no-cache \
  dumb-init \
  libpq \
  libxml2 \
  libxslt \
  nodejs \
  shared-mime-info \
  tzdata \
  yaml \
  && adduser -D -u 1000 -h /voctoweb rails

WORKDIR /voctoweb

ENV BUNDLE_FORCE_RUBY_PLATFORM=1 \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT=1 \
    RAILS_ENV=production \
    RAILS_SERVE_STATIC_FILES=true \
    RAILS_LOG_TO_STDOUT=true

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /voctoweb /voctoweb

RUN chown -R rails:rails /voctoweb
USER rails

EXPOSE 3000
ENTRYPOINT ["dumb-init", "--"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
